# Runtime files and generated files live here. They stay out of git.
libraries/
versions/
.fabric/
logs/
data/
*.log
# downloaded jars are reproducible via mods/manifest.json
mods/*.jar
!mods/manifest.json
# generated server dirs
bluemap/
# server-run state (rebuilt at boot)
config/Geyser-Fabric/cache/
config/Geyser-Fabric/saved-refresh-tokens.json
config/Geyser-Fabric/nethernet/
config/Geyser-Fabric/certs/
config/spark/tmp/
# local env
.env
# Floodgate private key: the live one is generated on the box, the repo must
# never hold a usable key (anyone reading it could mint trusted Bedrock logins).
config/floodgate/key.pem
