# Copy this file to .env and fill it in. Keep .env out of git, it is ignored.
# Cloudflare API token with DNS:Edit on the zone (lego issues via DNS-01, no open ports needed).
CLOUDFLARE_DNS_API_TOKEN=
# Bedrock join hostname. It must resolve straight to this box with DNS only. Grey cloud, no proxy. Use an A record or a CNAME.
# Players join with this AND the TLS cert is issued for it.
MCSERVER_DOMAIN=mc.farel.is-a.dev
# Let's Encrypt account contact.
ACME_EMAIL=admin@farel.at.eu.org
